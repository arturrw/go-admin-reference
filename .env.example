# Copy to .env (not committed) or export these before running the server.

# Postgres (docker compose up -d postgres). Leave empty to use the in-memory store.
DATABASE_URL=postgres://goadmin:goadmin@localhost:5433/goadmin?sslmode=disable
# Load demo data into an empty database on boot.
SEED=true

ADDR=:8080
APP_ENV=development
LOG_LEVEL=info
UPLOAD_DIR=data/uploads
SESSION_TTL=12h
